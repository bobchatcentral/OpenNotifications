    <dict>
      <key>cell</key><string>PSEditTextCell</string>
      <key>key</key><string>sender</string>
      <key>default</key><string>Alex</string>
      <key>placeholder</key><string>Sender name</string>
      <key>defaults</key><string>com.opennotifications.settings</string>
    </dict>
    <dict>
      <key>cell</key><string>PSEditTextCell</string>
